# Secrets and machine-local settings: never commit
.env
.env.*
.claude/settings.local.json
CLAUDE.local.md
**/CLAUDE.local.md

# Pre-compact snapshots (transient, may contain raw prompt text)
.claude/state/

# Quarantined daily logs (failed generator output, kept locally for inspection)
daily-logs/.quarantine/

# Obsidian workspace state and plugin data (plugin data can hold API keys)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# OS and editor noise
.DS_Store
**/.DS_Store
.vscode/
.idea/
*.swp

# Raw data exports usually hold other people's personal data. Keep them local;
# commit the Markdown you derive from them instead.
*.csv
*.xlsx

# Campaign Engine: your own campaign inputs in raw/campaigns/ stay on your
# machine (past briefs, results, sales feedback, CRM and email pulls). Only the
# README and the fictional Acme Deals example are committed. These lines must
# stay below the *.csv rule above.
raw/campaigns/*
!raw/campaigns/README.md
!raw/campaigns/example/
!raw/campaigns/example/**

# Campaign Engine: customer data, strategy docs and performance data stay local
# too (same rules as the Marketing Brain; harmless if already present).
raw/voc/*
!raw/voc/README.md
!raw/voc/review-urls.md
!raw/voc/example/
!raw/voc/example/*.csv
raw/strategy/*
!raw/strategy/README.md
raw/performance/*
!raw/performance/README.md
