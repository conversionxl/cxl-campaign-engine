      document.querySelectorAll(paneSel).forEach(function (p) { p.classList.toggle('active', p.id === id); });
      if (onShow) onShow(id);
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { show(b.dataset.tab); }); });
    return show;
  }
  var showMain = bindGroup('.tabs button', '.panel', function (id) { try { history.replaceState(null, '', '#' + id); } catch (e) {} });
  bindGroup('.subtabs button', '.subpanel');
  bindGroup('.views button', '.view');
  var start = (location.hash || '').slice(1);
  if (start && document.getElementById(start)) showMain(start);
  document.querySelectorAll('.copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var text = btn.parentNode.querySelector('span').innerText;
      function done(ok) { btn.textContent = ok ? 'Copied' : 'Select and copy'; setTimeout(function () { btn.textContent = 'Copy'; }, 1600); }
      try {
        navigator.clipboard.writeText(text).then(function () { done(true); }, function () { selectIt(); done(false); });
      } catch (e) { selectIt(); done(false); }
      function selectIt() { var r = document.createRange(); r.selectNodeContents(btn.parentNode.querySelector('span')); var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); }
    });
  });
})();
</script>
